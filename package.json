{
  "name": "codecollab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "next dev -p 3600",
    "dev:api": "cross-env NODE_ENV=development API_PORT=4600 node server/index.js",
    "setup:ml": "python -m pip install -r ml_service/requirements.txt",
    "dev:ml": "python -m uvicorn ml_service.main:app --reload --host 0.0.0.0 --port 8600",
    "build": "next build",
    "start": "concurrently \"npm run start:web\" \"npm run start:api\"",
    "start:web": "next start -p 3600",
    "start:api": "cross-env NODE_ENV=production API_PORT=4600 node server/index.js",
    "lint": "eslint . --ext .js,.ts,.tsx"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.19.2",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "next": "^16.1.6",
    "pg": "^8.12.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "y-protocols": "^1.0.6",
    "y-monaco": "^0.1.6",
    "yjs": "^13.6.24"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.1.6",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0"
  }
}
